\newdimen\utb@footcite@left
\newdimen\utb@cite@onecol@w
\newdimen\utb@cite@twocol@w
\newcommand{\utb@update@footcite@left}{%
  \def\utb@cur@lw{0pt}%
  \def\utb@cur@lgap{0pt}%
  \ifx\utb@flogo\utb@logo@full
    \def\utb@cur@lw{\utb@fW{fullW}}%
    \def\utb@cur@lgap{\utb@fW{gapfull}}%
  \else\ifx\utb@flogo\utb@logo@mark
    \def\utb@cur@lw{\utb@fW{markW}}%
    \def\utb@cur@lgap{\utb@fW{gapmark}}%
  \else\ifx\utb@flogo\utb@logo@wordmark
    \def\utb@cur@lw{\utb@fW{wordmarkW}}%
    \def\utb@cur@lgap{\utb@fW{gapwordmark}}%
  \else\ifx\utb@flogo\utb@logo@utb
    \def\utb@cur@lw{\utb@fW{utbW}}%
    \def\utb@cur@lgap{\utb@fW{gaputb}}%
  \fi\fi\fi\fi
  \ifdim\utb@cur@lw>0pt
    \setlength{\utb@footcite@left}{\dimexpr\utb@fW{footX} + \utb@cur@lw + \utb@cur@lgap - \utb@fW{mL}\relax}%
    \ifdim\utb@footcite@left<0pt\setlength{\utb@footcite@left}{0pt}\fi
  \else
    \setlength{\utb@footcite@left}{0pt}%
  \fi
  \ifx\utb@headerright\utb@hdr@pagenumber
    \setlength{\utb@cite@onecol@w}{\dimexpr\utb@fW{footXend} - (\utb@fW{footX} + \utb@cur@lw + \utb@cur@lgap)\relax}%
  \else
    \setlength{\utb@cite@onecol@w}{\dimexpr\paperwidth - (\utb@fW{footX} + \utb@cur@lw + \utb@cur@lgap) - 0.07\paperwidth\relax}%
  \fi
  \setlength{\utb@cite@twocol@w}{\dimexpr 0.485\utb@cite@onecol@w\relax}%
}

\renewcommand{\footnoterule}{}

\setbeamercolor{footnote}{fg=utbblack}
\setbeamercolor{footnote mark}{fg=utbmain}

\newcommand{\utb@make@notebox}[4]{%
  \sbox\utb@tmp@cbox{%
    \usebeamerfont{footnote}\selectfont\strut%
    {\color{#1}\usebeamerfont*{footnote mark}\textsuperscript{#2}}\,%
    {\usebeamercolor[fg]{footnote}\utbtruncate{#3}{#4}}\strut%
  }%
}

\newcommand{\utb@add@raw@footeritem}[3]{%
  \global\advance\c@utb@slide@citecount by 1\relax%
  \utb@update@footcite@left%
  \ifnum\c@utb@slide@citecount<9\relax
    \edef\utb@cur@slot{\romannumeral\c@utb@slide@citecount}%
    \ifnum\utb@citemax=-1\relax
      \utb@make@notebox{#1}{#2}{-1}{#3}%
      \ifdim\wd\utb@tmp@cbox>\utb@cite@onecol@w
        \sbox\utb@tmp@cbox{\resizebox{\utb@cite@onecol@w}{\height}{\usebox\utb@tmp@cbox}}%
      \fi
    \else
      \utb@make@notebox{#1}{#2}{115}{#3}%
      \ifdim\wd\utb@tmp@cbox>\utb@cite@onecol@w \utb@make@notebox{#1}{#2}{90}{#3}\fi
      \ifdim\wd\utb@tmp@cbox>\utb@cite@onecol@w \utb@make@notebox{#1}{#2}{72}{#3}\fi
      \ifdim\wd\utb@tmp@cbox>\utb@cite@onecol@w \utb@make@notebox{#1}{#2}{56}{#3}\fi
      \ifdim\wd\utb@tmp@cbox>\utb@cite@onecol@w \utb@make@notebox{#1}{#2}{42}{#3}\fi
      \ifdim\wd\utb@tmp@cbox>\utb@cite@onecol@w
        \sbox\utb@tmp@cbox{\resizebox{\utb@cite@onecol@w}{\height}{\usebox\utb@tmp@cbox}}%
      \fi
    \fi
    \global\setbox\csname utb@citebox@one@\utb@cur@slot\endcsname=\hbox{\unhbox\utb@tmp@cbox}%
    \ifnum\utb@citemax=-1\relax
      \utb@make@notebox{#1}{#2}{-1}{#3}%
      \ifdim\wd\utb@tmp@cbox>\utb@cite@twocol@w
        \sbox\utb@tmp@cbox{\resizebox{\utb@cite@twocol@w}{\height}{\usebox\utb@tmp@cbox}}%
      \fi
    \else
      \utb@make@notebox{#1}{#2}{52}{#3}%
      \ifdim\wd\utb@tmp@cbox>\utb@cite@twocol@w \utb@make@notebox{#1}{#2}{40}{#3}\fi
      \ifdim\wd\utb@tmp@cbox>\utb@cite@twocol@w \utb@make@notebox{#1}{#2}{30}{#3}\fi
      \ifdim\wd\utb@tmp@cbox>\utb@cite@twocol@w \utb@make@notebox{#1}{#2}{22}{#3}\fi
      \ifdim\wd\utb@tmp@cbox>\utb@cite@twocol@w
        \sbox\utb@tmp@cbox{\resizebox{\utb@cite@twocol@w}{\height}{\usebox\utb@tmp@cbox}}%
      \fi
    \fi
    \global\setbox\csname utb@citebox@two@\utb@cur@slot\endcsname=\hbox{\unhbox\utb@tmp@cbox}%
  \fi
}

\newcommand{\utb@build@slide@citebox}{%
  \global\setbox\utb@slide@citebox=\box\voidb@x%
  \gdef\utb@cite@rows{0}%
  \ifnum\c@utb@slide@citecount>0\relax
    \utb@update@footcite@left%
    \count@=\c@utb@slide@citecount\relax
    \ifnum\count@>\utb@citemax\relax \count@=\utb@citemax\relax \fi
    \ifnum\count@>8\relax \count@=8\relax \fi
    \edef\utb@eff@citecount{\the\count@}%
    \utb@use@twocolfalse
    \def\utb@tmp@ccol{2}%
    \ifx\utb@citecolumns\utb@tmp@ccol
      \ifnum\utb@eff@citecount>1\relax \utb@use@twocoltrue \fi
    \else
      \def\utb@tmp@ccol{auto}%
      \ifx\utb@citecolumns\utb@tmp@ccol
        \ifnum\utb@eff@citecount>\utb@citemaxlines\relax \utb@use@twocoltrue \fi
      \fi
    \fi
    \ifutb@use@twocol
      \count@=\numexpr\utb@eff@citecount + 1\relax
      \divide\count@ by 2\relax
      \ifnum\count@>\utb@citemaxlines\relax \count@=\utb@citemaxlines\relax \fi
      \ifnum\count@>4\relax \count@=4\relax \fi
      \xdef\utb@cite@rows{\the\count@}%
      \global\setbox\utb@slide@citebox=\vbox{%
        \count255=1\relax
        \loop
          \hbox to \utb@cite@onecol@w{%
            \hbox to \utb@cite@twocol@w{\unhcopy\csname utb@citebox@two@\romannumeral\count255\endcsname\hss}%
            \hfill
            \count@=\numexpr\count255 + \utb@cite@rows\relax
            \unless\ifnum\count@>\utb@eff@citecount\relax
              \hbox to \utb@cite@twocol@w{\unhcopy\csname utb@citebox@two@\romannumeral\count@\endcsname\hss}%
            \else
              \hbox to \utb@cite@twocol@w{\hss}%
            \fi
          }%
          \ifnum\count255<\utb@cite@rows\relax
            \vskip 0.8pt%
          \fi
          \advance\count255 by 1\relax
        \unless\ifnum\count255>\utb@cite@rows\relax \repeat
      }%
    \else
      \count@=\utb@eff@citecount\relax
      \ifnum\count@>\utb@citemaxlines\relax \count@=\utb@citemaxlines\relax \fi
      \ifnum\count@>4\relax \count@=4\relax \fi
      \xdef\utb@cite@rows{\the\count@}%
      \global\setbox\utb@slide@citebox=\vbox{%
        \count255=1\relax
        \loop
          \hbox to \utb@cite@onecol@w{\unhcopy\csname utb@citebox@one@\romannumeral\count255\endcsname\hss}%
          \ifnum\count255<\utb@cite@rows\relax
            \vskip 0.8pt%
          \fi
          \advance\count255 by 1\relax
        \unless\ifnum\count255>\utb@cite@rows\relax \repeat
      }%
    \fi
  \fi
}

