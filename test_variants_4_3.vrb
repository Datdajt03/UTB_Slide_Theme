\frametitle{Biểu diễn giải thuật tối ưu hóa đa mục tiêu với algorithm2e, listings và minted trong trình chiếu khoa học}\framesubtitle {Cấu trúc mã giả khoa học và khối mã nguồn tô màu cú pháp đa ngôn ngữ}
  \begin{columns}[T]
    \begin{column}{0.49\textwidth}
      \begin{minipage}{\linewidth}
      \begin{algorithm}[H]
        \scriptsize
        \caption{Thuật toán MPG-E}\label{algo:mpg}
        \KwIn{$x_0 \in \mathcal{X}$, $\beta \in (0,1)$, $\gamma > 0$}
        \KwOut{Nghiệm Pareto yếu $x^*$}
        \BlankLine
        \For{$k = 0, 1, 2, \dots$}{
          $d_k = \argmin_{d} \left\{ \max_i \innerp{\nabla f_i(x_k)}{d} + \frac{1}{2}\norm{d}^2 \right\}$\;
          \If{$\norm{d_k} < \epsilon$}{
            \Return $x_k$\;
          }
          $x_{k+1} = \mathrm{Proj}_{\mathcal{X}}(x_k + \alpha_k d_k)$\;
        }
      \end{algorithm}
      \end{minipage}
    \end{column}

    \begin{column}{0.49\textwidth}
\begin{lstlisting}[style=utbcode, language=Python]
import numpy as np
def mpg_step(x, grad, alpha=0.01):
    d_k = -np.mean(grad(x), axis=0)
    return x + alpha * d_k
\end{lstlisting}
\vskip -4pt
\utbcaption[Listing][1]{Hàm mục tiêu Python (\texttt{listings})}\label{lst:python}
\vskip 2pt
\begin{minted}{cpp}
double clip_box(double x, double r) {
    // Chieu len mien [-r, r]
    return std::clamp(x, -r, r);
}
\end{minted}
\vskip -4pt
\utbcaption[Listing][2]{Hàm C++ (\texttt{minted}, cần Python \& \texttt{-shell-escape})}\label{lst:cpp}
    \end{column}
  \end{columns}
