%% beamerthemeUTB.sty -- Tay Bac University (UTB / Trường Đại học Tây Bắc)
%%
%%   \usetheme[color=green,font=rokkit,footerlogo=full]{UTB}
%%
%% Theme options:
%%   color        = green | navy | blue (green is default)
%%   font         = rokkit | lato | arial | times | cm
%%   titlefont    = same | avantgarde | barberfill
%%   footerlogo   = full | mark | wordmark | utb | none
%%   bar          = thin | thick
%%   titlepage    = cover | dark | solid | light | welcome
%%   sectionpage  = none | panel
%%   numbering    = none | plain | fraction
%%   footer       = <text centred in the footer>
%%   footerleft   = <text at the left of the footer>
%%
\ProvidesPackage{beamerthemeUTB}[2026/10/31 UTB Beamer theme]
\RequirePackage{utb-core}
\ProcessPgfPackageOptions{/utb}   % reads \usetheme[...]{UTB}
\useinnertheme{UTB}
\useoutertheme{UTB}
\usecolortheme{UTB}
\usefonttheme{UTB}

%% ------------------------------------------------------------- BibLaTeX & Citations
\newcommand{\utbfootcite}[2][]{%
  \edef\utb@cur@slidenum{\insertframenumber}%
  \@ifundefined{utb@cited@\utb@cur@slidenum @#2}{%
    \ifstrempty{#1}{\utb@footcite@internal{#2}}{\utb@footcite@internal[#1]{#2}}%
    \expandafter\xdef\csname utb@cited@\utb@cur@slidenum @#2\endcsname{\thefootnote}%
  }{%
    {\usebeamercolor[fg]{footnote mark}\usebeamerfont*{footnote mark}\textsuperscript{\csname utb@cited@\utb@cur@slidenum @#2\endcsname}}%
  }%
}
\let\hustfootcite\utbfootcite

\newcounter{utbbibidx}
\def\utb@bib@from{1}
\def\utb@bib@to{0}
\def\utb@tmp@tlim{40}
\def\utb@tmp@jlim{30}

\newcommand{\utb@format@bibbox}[5]{%
  \def\utb@tmp@tlim{#2}%
  \def\utb@tmp@jlim{#3}%
  \sbox\utb@tmp@cbox{%
    \usebeamerfont{footnote}\selectfont\strut%
    {\usebeamercolor[fg]{footnote mark}\usebeamerfont*{footnote mark}\textsuperscript{#1}}\,%
    {\usebeamercolor[fg]{footnote}%
     \ifnum#4=1\relax
       \printnames[utbshortauthor][1-1]{labelname}%
     \else
       \printnames[given-family][1-1]{labelname}%
     \fi
     \setunit{\addperiod\space}%
     \printfield[utbtruncquote]{title}%
     \ifnum#5=1\relax
       \setunit{\addperiod\space}%
       \iffieldundef{journaltitle}{%
         \iffieldundef{booktitle}{}{%
           \printfield[utbtruncemph]{booktitle}%
         }%
       }{%
         \printfield[utbtruncemph]{journaltitle}%
       }%
       \setunit{\space}%
       \printfield{volume}%
       \setunit{\space}%
       \printtext[parens]{\printdate}%
       \addperiod
     \else
       \setunit{\space}%
       \printtext[parens]{\printdate}%
       \addperiod
     \fi
    }\strut%
  }%
}

\newcommand{\utb@record@bibcite}[1]{%
  \global\advance\c@utb@slide@citecount by 1\relax%
  \utb@update@footcite@left%
  \ifnum\c@utb@slide@citecount<9\relax
    \edef\utb@cur@slot{\romannumeral\c@utb@slide@citecount}%
    \edef\utb@init@tlim{\ifnum\utb@citetitlemax=-1 -1\else\ifnum\utb@citetitlemax>0 \utb@citetitlemax\else\ifutb@wide 48\else 36\fi\fi\fi}%
    \edef\utb@init@jlim{\ifnum\utb@citejournalmax=-1 -1\else\ifnum\utb@citejournalmax>0 \utb@citejournalmax\else\ifutb@wide 38\else 28\fi\fi\fi}%
    \utb@format@bibbox{#1}{\utb@init@tlim}{\utb@init@jlim}{0}{1}%
    \ifnum\utb@citetitlemax=-1\relax
      \ifdim\wd\utb@tmp@cbox>\utb@cite@onecol@w
        \sbox\utb@tmp@cbox{\resizebox{\utb@cite@onecol@w}{\height}{\usebox\utb@tmp@cbox}}%
      \fi
    \else
      \ifdim\wd\utb@tmp@cbox>\utb@cite@onecol@w \utb@format@bibbox{#1}{36}{26}{1}{1}\fi
      \ifdim\wd\utb@tmp@cbox>\utb@cite@onecol@w \utb@format@bibbox{#1}{28}{20}{1}{1}\fi
      \ifdim\wd\utb@tmp@cbox>\utb@cite@onecol@w \utb@format@bibbox{#1}{20}{15}{1}{1}\fi
      \ifdim\wd\utb@tmp@cbox>\utb@cite@onecol@w \utb@format@bibbox{#1}{18}{0}{1}{0}\fi
      \ifdim\wd\utb@tmp@cbox>\utb@cite@onecol@w
        \sbox\utb@tmp@cbox{\resizebox{\utb@cite@onecol@w}{\height}{\usebox\utb@tmp@cbox}}%
      \fi
    \fi
    \global\setbox\csname utb@citebox@one@\utb@cur@slot\endcsname=\hbox{\unhbox\utb@tmp@cbox}%
    \edef\utb@init@twotlim{\ifnum\utb@citetitlemax=-1 -1\else\ifutb@wide 30\else 22\fi\fi}%
    \utb@format@bibbox{#1}{\utb@init@twotlim}{0}{1}{0}%
    \ifnum\utb@citetitlemax=-1\relax
      \ifdim\wd\utb@tmp@cbox>\utb@cite@twocol@w
        \sbox\utb@tmp@cbox{\resizebox{\utb@cite@twocol@w}{\height}{\usebox\utb@tmp@cbox}}%
      \fi
    \else
      \ifdim\wd\utb@tmp@cbox>\utb@cite@twocol@w \utb@format@bibbox{#1}{22}{0}{1}{0}\fi
      \ifdim\wd\utb@tmp@cbox>\utb@cite@twocol@w \utb@format@bibbox{#1}{16}{0}{1}{0}\fi
      \ifdim\wd\utb@tmp@cbox>\utb@cite@twocol@w \utb@format@bibbox{#1}{11}{0}{1}{0}\fi
      \ifdim\wd\utb@tmp@cbox>\utb@cite@twocol@w
        \sbox\utb@tmp@cbox{\resizebox{\utb@cite@twocol@w}{\height}{\usebox\utb@tmp@cbox}}%
      \fi
    \fi
    \global\setbox\csname utb@citebox@two@\utb@cur@slot\endcsname=\hbox{\unhbox\utb@tmp@cbox}%
  \fi
}

\newcommand{\utb@setup@biblatex}{%
  \renewbibmacro*{in:}{}%
  \DeclareNameFormat{utbshortauthor}{%
    \usebibmacro{name:given-family}
      {\namepartfamily}
      {\namepartgiveni}
      {\namepartprefix}
      {\namepartsuffix}%
    \usebibmacro{name:andothers}%
  }%
  \DeclareFieldFormat[article,inbook,incollection,inproceedings,patent,thesis,unpublished,book,misc,techreport]{utbtruncquote}{%
    \mkbibquote{\utbtruncate{\utb@tmp@tlim}{##1}}%
  }%
  \DeclareFieldFormat[article,inbook,incollection,inproceedings,patent,thesis,unpublished,book,misc,techreport]{utbtruncemph}{%
    \mkbibemph{\utbtruncate{\utb@tmp@jlim}{##1}}%
  }%
  \DeclareCiteCommand{\utb@footcite@internal}
    {\usebibmacro{prenote}}
    {\usebibmacro{citeindex}%
     \stepcounter{footnote}%
     {\usebeamercolor[fg]{footnote mark}\usebeamerfont*{footnote mark}\textsuperscript{\thefootnote}}%
     \utb@record@bibcite{\thefootnote}}
    {\multicitedelim}
    {\usebibmacro{postnote}}%
  \let\footcite\utbfootcite
  \let\cite\utbfootcite
  \defbibcheck{utbrange}{%
    \stepcounter{utbbibidx}%
    \ifnum\value{utbbibidx}<\utb@bib@from\relax
      \skipentry
    \else
      \ifnum\utb@bib@to>0\relax
        \ifnum\value{utbbibidx}>\utb@bib@to\relax
          \skipentry
        \fi
      \fi
    \fi
  }%
  \setbeamertemplate{bibliography item}[text]%
  \setbeamercolor{bibliography item}{fg=utbmain}%
  \setbeamercolor{bibliography entry author}{fg=utbblack}%
  \setbeamercolor{bibliography entry title}{fg=utbblack}%
  \setbeamercolor{bibliography entry location}{fg=utbblack}%
  \setbeamercolor{bibliography entry note}{fg=utbblack}%
}

\AddToHook{package/biblatex/after}{\utb@setup@biblatex}
\AddToHook{package/biblatex/after}{\defbibcheck{hustrange}{\defbibcheck{utbrange}}}
\@ifpackageloaded{biblatex}{\utb@setup@biblatex}{}

\define@key{utbbib}{from}{\def\utb@bib@from{#1}}
\define@key{utbbib}{to}{\def\utb@bib@to{#1}}
\define@key{utbbib}{title}{\def\utb@bib@title{#1}}
\define@key{utbbib}{subtitle}{\def\utb@bib@subtitle{#1}}

\newcommand{\utb@set@bibkeys}[1]{%
  \in@{=}{#1}%
  \ifin@
    \setkeys{utbbib}{#1}%
  \else
    \ifstrempty{#1}{}{\def\utb@bib@title{#1}}%
  \fi
}

\newenvironment{utbreferencesframe}[1][]{%
  \def\utb@bib@from{1}%
  \def\utb@bib@to{0}%
  \let\utb@bib@title\utbreftitle
  \let\utb@bib@subtitle\utbrefsubtitle
  \utb@set@bibkeys{#1}%
  \edef\utb@check@bibsub{\utb@bib@subtitle}%
  \ifdefstring{\utb@check@bibsub}{Hidden}{\def\utb@check@bibsub{}}{}%
  \ifdefstring{\utb@check@bibsub}{hidden}{\def\utb@check@bibsub{}}{}%
  \ifdefstring{\utb@check@bibsub}{none}{\def\utb@check@bibsub{}}{}%
  \global\utb@framenoprogressbartrue%
  \begin{frame}[environment=utbreferencesframe,noprogressbar]%
    \frametitle{\utb@bib@title}%
    \ifx\utb@check@bibsub\@empty\else
      \framesubtitle{\utb@check@bibsub}%
    \fi
    \setcounter{utbbibidx}{0}%
    \printbibliography[check=utbrange,heading=none]%
}{%
  \end{frame}%
}

\newcommand{\utbprintreferences}[1][]{%
  \begin{utbreferencesframe}[#1]%
  \end{utbreferencesframe}%
}

%% Aliases
\let\hustreferencesframe\utbreferencesframe
\let\endhustreferencesframe\endutbreferencesframe
\let\hustprintreferences\utbprintreferences

\endinput
