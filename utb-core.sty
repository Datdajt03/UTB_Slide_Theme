%% utb-core.sty -- shared options, brand colours and geometry for the UTB Beamer theme
%% Trường Đại học Tây Bắc (UTB / Tay Bac University)
%%
%% Everything that depends on the paper ratio lives here as *fractions* of the
%% page width / height, measured from the official PPTX templates (16:9 and 4:3).
%% Ratios other than 16:9 / 4:3 (5:4, 16:10, 14:9, 3:2 ...) use the closest of
%% the two measured sets (wide set for width/height >= 1.55, otherwise 4:3 set).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{utb-core}[2026/10/31 UTB Beamer theme: options, colours, geometry]

\RequirePackage{iftex}
\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{colortbl}
\RequirePackage{pgfkeys}
\RequirePackage{pgfopts}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\ifPDFTeX
  \PackageError{utb-core}{The UTB theme needs LuaLaTeX or XeLaTeX}{%
    It uses fontspec for Rokkitt / Lato / Arial / Times New Roman.^^J%
    TeXstudio: Options > Configure TeXstudio > Build > Default Compiler = LuaLaTeX (or XeLaTeX).}
\fi

