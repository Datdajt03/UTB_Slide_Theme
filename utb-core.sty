%% ------------------------------------------------------------ Vietnamese Date Format
\newcommand{\utb@set@today}{%
  \def\today{%
    \ifutb@dateaddress
      \ifx\utb@date@address\@empty
        ngày \number\day\ tháng \number\month\ năm \number\year
      \else
        \utb@date@address, ngày \number\day\ tháng \number\month\ năm \number\year
      \fi
    \else
      ngày \number\day\ tháng \number\month\ năm \number\year
    \fi
  }%
}
\utb@set@today
\AtBeginDocument{\utb@set@today}

\newcommand{\utbdate}[4][]{%
  \gdef\utb@recorded@shortdate{\ifnum#2<10 0\fi\number#2/\ifnum#3<10 0\fi\number#3/\number#4}%
  \begingroup
    \def\utb@tmp@addr{\utb@date@address}%
    \ifstrempty{#1}{}{%
      \ifstrequal{#1}{none}{\def\utb@tmp@addr{}}{%
        \ifstrequal{#1}{off}{\def\utb@tmp@addr{}}{%
          \ifstrequal{#1}{false}{\def\utb@tmp@addr{}}{%
            \def\utb@tmp@addr{#1}%
          }%
        }%
      }%
    }%
    \ifutb@dateaddress
      \ifx\utb@tmp@addr\@empty
        ngày #2 tháng #3 năm #4%
      \else
        \utb@tmp@addr, ngày #2 tháng #3 năm #4%
      \fi
    \else
      \ifstrempty{#1}{%
        ngày #2 tháng #3 năm #4%
      }{%
        \ifstrequal{#1}{none}{ngày #2 tháng #3 năm #4}{%
          \ifstrequal{#1}{off}{ngày #2 tháng #3 năm #4}{%
            #1, ngày #2 tháng #3 năm #4%
          }%
        }%
      }%
    \fi
  \endgroup
}
\let\hustdate\utbdate
\let\vntoday\today
\let\vietnamesedate\today

\newcommand{\utb@dateshort}{%
  \ifx\utb@recorded@shortdate\@empty
    \ifnum\day<10 0\fi\number\day/%
    \ifnum\month<10 0\fi\number\month/%
    \number\year
  \else
    \utb@recorded@shortdate
  \fi
}

