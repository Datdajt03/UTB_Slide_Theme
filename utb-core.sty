%% UTF-8 safe word-boundary string truncation for footer citations & notes
\ifdefined\directlua
\directlua{
  function utb_utf8_truncate(str, max_len)
    max_len = tonumber(max_len) or 35
    if max_len <= 0 or not str or str == "" then
      tex.sprint(str or "")
      return
    end
    local ulen = unicode.utf8.len(str)
    if not ulen or ulen <= max_len then
      tex.sprint(str)
      return
    end
    local sub = unicode.utf8.sub(str, 1, max_len)
    local lb = string.char(123)
    local rb = string.char(125)
    local dl = string.char(36)
    local depth = 0
    local in_math = false
    local last_space = nil
    local min_cut = math.floor(max_len * 0.55)
    for i = 1, max_len do
      local ch = unicode.utf8.sub(sub, i, i)
      if ch == dl then
        in_math = not in_math
      elseif ch == lb then
        depth = depth + 1
      elseif ch == rb and depth > 0 then
        depth = depth - 1
      elseif ch == " " and depth == 0 and not in_math and i >= min_cut then
        last_space = i - 1
      end
    end
    if last_space and last_space > 0 then
      sub = unicode.utf8.sub(sub, 1, last_space)
    end
    while string.len(sub) > 0 do
      local lastc = string.sub(sub, -1)
      if lastc == " " or lastc == "," or lastc == ";" or lastc == ":" or lastc == "." or lastc == "-" then
        sub = string.sub(sub, 1, -2)
      else
        break
      end
    end
    local open_b = 0
    local open_m = false
    for i = 1, string.len(sub) do
      local c = string.sub(sub, i, i)
      if c == dl then open_m = not open_m
      elseif c == lb then open_b = open_b + 1
      elseif c == rb and open_b > 0 then open_b = open_b - 1 end
    end
    if open_m then sub = sub .. dl end
    if open_b > 0 then sub = sub .. string.rep(rb, open_b) end
    tex.sprint(sub .. "...")
  end
  hust_utf8_truncate = utb_utf8_truncate
}
\newcommand{\utbtruncate}[2]{%
  \directlua{utb_utf8_truncate("\luaescapestring{\unexpanded{#2}}", \number\numexpr#1\relax)}%
}
\let\husttruncate\utbtruncate

%% Width-based string truncation
\newbox\utb@tbox
\newdimen\utb@tmax
\newcount\utb@tlow
\newcount\utb@thigh
\newcount\utb@tmid
\def\utb@tbest{...}

\directlua{
  utb_t_str = ""
  function utb_t_set(s)
    utb_t_str = s
    return unicode.utf8.len(s)
  end
  function utb_t_sub(k)
    local sub = unicode.utf8.sub(utb_t_str, 1, k)
    while string.sub(sub, -1) == " " do
      sub = string.sub(sub, 1, -2)
    end
    local bs = string.match(sub, "\\+$")
    if bs and math.fmod(string.len(bs), 2) == 1 then
      sub = string.sub(sub, 1, -2)
    end
    local dl = string.char(36)
    local lb = string.char(123)
    local rb = string.char(125)
    local open_b = 0
    local open_m = false
    for i = 1, string.len(sub) do
      local c = string.sub(sub, i, i)
      if c == dl then open_m = not open_m
      elseif c == lb then open_b = open_b + 1
      elseif c == rb and open_b > 0 then open_b = open_b - 1 end
    end
    if open_m then sub = sub .. dl end
    if open_b > 0 then sub = sub .. string.rep(rb, open_b) end
    tex.sprint(sub .. "...")
  end
  hust_t_str = utb_t_str
  hust_t_set = utb_t_set
  hust_t_sub = utb_t_sub
}

\newcommand{\utbtruncateto}[3]{%
  \begingroup
    #2\relax
    \protected@edef\utb@t@str{#3}%
    \setbox\utb@tbox=\hbox{\utb@t@str}%
    \ifdim\wd\utb@tbox>#1\relax
      \utb@tmax=#1\relax
      \utb@thigh=\directlua{tex.sprint(utb_t_set("\luaescapestring{\utb@t@str}"))}\relax
      \utb@tlow=1\relax
      \def\utb@tbest{...}%
      \utb@tloop{#2}%
      \utb@tbest
    \else
      \utb@t@str
    \fi
  \endgroup
}

\def\utb@tloop#1{%
  \ifnum\utb@tlow>\utb@thigh\else
    \utb@tmid=\numexpr(\utb@tlow + \utb@thigh) / 2\relax
    \begingroup
      #1\relax
      \setbox\utb@tbox=\hbox{\directlua{utb_t_sub(\the\utb@tmid)}}%
      \ifdim\wd\utb@tbox>\utb@tmax\relax
        \global\utb@thigh=\numexpr\utb@tmid - 1\relax
      \else
        \global\let\utb@tmpbest\relax
        \xdef\utb@tmpbest{\directlua{utb_t_sub(\the\utb@tmid)}}%
        \global\utb@tlow=\numexpr\utb@tmid + 1\relax
      \fi
    \endgroup
    \ifx\utb@tmpbest\relax\else
      \let\utb@tbest\utb@tmpbest
      \global\let\utb@tmpbest\relax
    \fi
    \utb@tloop{#1}%
  \fi
}
\let\utbtruncatetowidth\utbtruncateto
\let\husttruncateto\utbtruncateto
\let\husttruncatetowidth\utbtruncateto
\else
\newcommand{\utbtruncate}[2]{#2}
\newcommand{\utbtruncateto}[3]{#3}
\let\utbtruncatetowidth\utbtruncateto
\let\husttruncate\utbtruncate
\let\husttruncateto\utbtruncateto
\let\husttruncatetowidth\utbtruncateto
\fi

