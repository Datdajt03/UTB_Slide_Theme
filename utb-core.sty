  \sbox\utb@wm@imgbox{\includegraphics[height=\utb@wm@h@dim]{\utb@wm@img}}%
  \sbox\utb@wm@vnbox{{\utb@logofont\fontsize{0.25\utb@wm@h@dim}{0.25\utb@wm@h@dim}\selectfont\bfseries\color{\utb@wm@col}TRƯỜNG ĐẠI HỌC TÂY BẮC}}%
  \sbox\utb@wm@enbox{{\utb@logofont\fontsize{0.14\utb@wm@h@dim}{0.14\utb@wm@h@dim}\selectfont\mdseries\color{\utb@wm@col}TAY BAC UNIVERSITY}}%
  \vbox{%
